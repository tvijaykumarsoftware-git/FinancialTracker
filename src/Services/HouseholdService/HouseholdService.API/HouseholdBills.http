@baseUrl = http://localhost:5002
@userId = 11111111-1111-1111-1111-111111111111
@billId = 22222222-2222-2222-2222-222222222222

### List bills for a user
GET {{baseUrl}}/api/household/bills/user/{{userId}}

### Get a bill
GET {{baseUrl}}/api/household/bills/{{billId}}/user/{{userId}}

### Create a bill
POST {{baseUrl}}/api/household/bills/user/{{userId}}
Content-Type: application/json

{
  "category": "Electricity",
  "provider": "City Power Corp",
  "consumerNumber": "METER-12345",
  "amount": 145.50,
  "dueDate": "2026-11-05"
}

### Update a bill
PUT {{baseUrl}}/api/household/bills/{{billId}}/user/{{userId}}
Content-Type: application/json

{
  "category": "Electricity",
  "provider": "City Power Corp",
  "consumerNumber": "METER-12345",
  "amount": 145.50,
  "dueDate": "2026-11-05",
  "status": "Paid"
}

### Delete a bill
DELETE {{baseUrl}}/api/household/bills/{{billId}}/user/{{userId}}
