@baseUrl = http://localhost:5003
@userId = 11111111-1111-1111-1111-111111111111
@billId = 22222222-2222-2222-2222-222222222222

### List medical expenses for a user
GET {{baseUrl}}/api/healthcare/bills/user/{{userId}}

### Get a medical expense
GET {{baseUrl}}/api/healthcare/bills/{{billId}}/user/{{userId}}

### Create a medical expense
POST {{baseUrl}}/api/healthcare/bills/user/{{userId}}
Content-Type: application/json

{
  "serviceName": "City General Hospital",
  "patientDetail": "Routine checkup and diagnostics",
  "billDate": "2026-10-12",
  "insuranceCovered": 450.00,
  "outOfPocketDue": 85.00,
  "status": "Pending"
}

### Update a medical expense
PUT {{baseUrl}}/api/healthcare/bills/{{billId}}/user/{{userId}}
Content-Type: application/json

{
  "serviceName": "City General Hospital",
  "patientDetail": "Routine checkup and diagnostics",
  "billDate": "2026-10-12",
  "insuranceCovered": 450.00,
  "outOfPocketDue": 85.00,
  "status": "Paid"
}

### Delete a medical expense
DELETE {{baseUrl}}/api/healthcare/bills/{{billId}}/user/{{userId}}
